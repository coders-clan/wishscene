# No environment variables are needed for pnpm dev.
# Set only for a local `pnpm build && pnpm start` demo:
WISHSCENE_MOCK=1
# Never put real provider credentials or personal photos into this scaffold.

# Shared developer feedback is also enabled by WISHSCENE_MOCK=1.
WISHSCENE_FEEDBACK=1
# Neon pooled Postgres URL; server-only. Enables durable studio AND feedback.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional overrides:
# WISHSCENE_DATABASE_URL=
# WISHSCENE_FEEDBACK_DATABASE_URL=
# Local SQLite feedback fallback. Use a mounted persistent disk on Render.
# WISHSCENE_FEEDBACK_DB=/YOUR_MOUNT/wishscene.feedback.sqlite

# GitHub sign-in (production only; see docs/DEPLOYMENT.md). Local dev stays open unless set.
# WISHSCENE_GITHUB_CLIENT_ID=
# WISHSCENE_GITHUB_CLIENT_SECRET=
# WISHSCENE_SESSION_SECRET=
# Optional canonical HTTPS origin for OAuth redirects, with no path or trailing content.
# WISHSCENE_PUBLIC_ORIGIN=https://project-rxuus.vercel.app
